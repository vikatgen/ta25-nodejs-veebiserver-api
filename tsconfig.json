{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "module": "nodenext",
    "target": "esnext",
    "types": ["node", "express"],
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedParameters": true,
    "strict": true,
    "verbatimModuleSyntax": false,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
